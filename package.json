{
  "name": "ras-stack",
  "version": "0.45.1",
  "description": "Composable full-stack primitives shared across Richard Solomou's applications.",
  "keywords": [
    "authentication",
    "centrifugo",
    "fullstack",
    "tanstack",
    "tus"
  ],
  "homepage": "https://github.com/richardsolomou/ras-stack#readme",
  "bugs": "https://github.com/richardsolomou/ras-stack/issues",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/richardsolomou/ras-stack.git"
  },
  "bin": {
    "ras": "./dist/cli.js"
  },
  "files": [
    "dist",
    "config",
    "examples/full-stack"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./auth/client": {
      "types": "./dist/auth/client.d.ts",
      "default": "./dist/auth/client.js"
    },
    "./auth/react": {
      "types": "./dist/auth/react.d.ts",
      "default": "./dist/auth/react.js"
    },
    "./email": {
      "types": "./dist/email/index.d.ts",
      "default": "./dist/email/index.js"
    },
    "./build": {
      "types": "./dist/build/index.d.ts",
      "default": "./dist/build/index.js"
    },
    "./database": {
      "types": "./dist/database/index.d.ts",
      "default": "./dist/database/index.js"
    },
    "./database/sqlite": {
      "types": "./dist/database/sqlite.d.ts",
      "default": "./dist/database/sqlite.js"
    },
    "./database/postgres": {
      "types": "./dist/database/postgres.d.ts",
      "default": "./dist/database/postgres.js"
    },
    "./conformance": {
      "types": "./dist/conformance/index.d.ts",
      "default": "./dist/conformance/index.js"
    },
    "./create": {
      "types": "./dist/create/index.d.ts",
      "default": "./dist/create/index.js"
    },
    "./policy": {
      "types": "./dist/policy/index.d.ts",
      "default": "./dist/policy/index.js"
    },
    "./posthog": {
      "types": "./dist/posthog/index.d.ts",
      "default": "./dist/posthog/index.js"
    },
    "./posthog/client": {
      "types": "./dist/posthog/client.d.ts",
      "default": "./dist/posthog/client.js"
    },
    "./posthog/proxy": {
      "types": "./dist/posthog/proxy.d.ts",
      "default": "./dist/posthog/proxy.js"
    },
    "./posthog/react": {
      "types": "./dist/posthog/react.d.ts",
      "default": "./dist/posthog/react.js"
    },
    "./posthog/server": {
      "types": "./dist/posthog/server.d.ts",
      "default": "./dist/posthog/server.js"
    },
    "./preview/dokploy": {
      "types": "./dist/preview/dokploy.d.ts",
      "default": "./dist/preview/dokploy.js"
    },
    "./preview/github": {
      "types": "./dist/preview/github.d.ts",
      "default": "./dist/preview/github.js"
    },
    "./realtime": {
      "types": "./dist/realtime/index.d.ts",
      "default": "./dist/realtime/index.js"
    },
    "./realtime/client": {
      "types": "./dist/realtime/client.d.ts",
      "default": "./dist/realtime/client.js"
    },
    "./realtime/react": {
      "types": "./dist/realtime/react.d.ts",
      "default": "./dist/realtime/react.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./tanstack/query": {
      "types": "./dist/tanstack/query.d.ts",
      "default": "./dist/tanstack/query.js"
    },
    "./tanstack/middleware": {
      "types": "./dist/tanstack/middleware.d.ts",
      "default": "./dist/tanstack/middleware.js"
    },
    "./tanstack/server": {
      "types": "./dist/tanstack/server.d.ts",
      "default": "./dist/tanstack/server.js"
    },
    "./uploads": {
      "types": "./dist/uploads/index.d.ts",
      "default": "./dist/uploads/index.js"
    },
    "./config/oxlint": "./config/oxlint.json",
    "./config/oxlint/application": "./config/oxlint/application.json",
    "./config/oxlint/tanstack": "./config/oxlint/tanstack.json",
    "./config/typescript/base": "./config/typescript/base.json",
    "./config/typescript/browser": "./config/typescript/browser.json",
    "./config/typescript/bundler": "./config/typescript/bundler.json",
    "./config/typescript/library": "./config/typescript/library.json",
    "./config/typescript/node-bundler": "./config/typescript/node-bundler.json",
    "./config/typescript/tanstack": "./config/typescript/tanstack.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "config:check": "tsc -p test/config-consumer/tsconfig.json && tsc -p test/config-consumer/tsconfig-bundler.json && tsc -p test/config-consumer/tsconfig-node-bundler.json && tsc -p test/config-consumer/tsconfig-library.json && oxlint --config config/oxlint/application.json --print-config > /dev/null && oxlint --config config/oxlint/tanstack.json --print-config > /dev/null",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run --config vitest.config.ts",
    "package:check": "node scripts/checkPackedPackage.mjs",
    "peer:floor": "node scripts/checkPeerFloor.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm config:check && pnpm typecheck && pnpm test && pnpm build && pnpm package:check && pnpm --filter @ras-stack/example-full-stack check && node dist/cli.js policy check",
    "version-packages": "changeset version"
  },
  "dependencies": {
    "@inquirer/confirm": "^6.1.1",
    "@inquirer/select": "^5.2.1",
    "yaml": "^2.8.2"
  },
