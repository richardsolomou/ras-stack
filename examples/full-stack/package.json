{
  "name": "@ras-stack/example-full-stack",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && node ../../packages/ras-stack/dist/cli.js assets sync && esbuild scripts/containerRuntime.ts scripts/database.ts --bundle --platform=node --format=esm --target=node24 --external:better-sqlite3 --outdir=.output/server --out-extension:.js=.mjs --log-level=warning && node ../../packages/ras-stack/dist/cli.js assets check",
    "dev": "vite dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --config oxlint.json --type-aware --deny-warnings .",
    "realtime": "node ../../packages/ras-stack/dist/cli.js realtime --config centrifugo.json --name ras-stack-example-realtime --port 8100 --origin http://localhost:3100 --secret example-development-secret --connect-proxy-endpoint http://host.docker.internal:3100/api/centrifugo/connect",
    "e2e": "playwright test",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "db:backup": "node .output/server/database.mjs backup",
    "db:restore": "node .output/server/database.mjs restore",
    "check": "pnpm format:check && pnpm lint && pnpm build && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@posthog/react": "^1.11.3",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.3",
    "better-auth": "1.7.10",
    "better-sqlite3": "12.11.1",
    "centrifuge": "5.7.4",
    "drizzle-orm": "0.45.4",
    "nodemailer": "^10.1.7",
    "posthog-js": "^1.438.12",
    "posthog-node": "^5.56.2",
    "ras-stack": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tus-js-client": "^4.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "0.28.2",
    "nitro": "3.0.260903-beta",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2",
    "vite": "8.3.4",
    "vitest": "^4.1.12"
  }
}
