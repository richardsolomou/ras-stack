APP_URL=http://localhost:3100
DATA_DIR=.data/example-full-stack
TRUST_PROXY=false
CENTRIFUGO_API_URL=http://127.0.0.1:8100/api
CENTRIFUGO_API_KEY=example-development-secret
CENTRIFUGO_PROXY_SECRET=example-development-secret
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM=ras-stack@example.test
EMAIL_REQUIRE_VERIFICATION=true
UPLOAD_MAX_BYTES=1000000
UPLOAD_QUOTA_BYTES=5000000
UPLOAD_GLOBAL_QUOTA_BYTES=100000000
UPLOAD_GLOBAL_MAX_FILES=1024
