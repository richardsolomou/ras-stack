{
  "name": "ras-stack",
  "version": "6.0.1",
  "description": "Compiler and lint presets and preview deployment tooling for applications built from RAS recipes.",
  "keywords": [
    "dokploy",
    "oxlint",
    "preview-deployments",
    "typescript"
  ],
  "homepage": "https://github.com/richardsolomou/ras-stack/tree/main/packages/ras-stack#readme",
  "bugs": "https://github.com/richardsolomou/ras-stack/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/richardsolomou/ras-stack.git",
    "directory": "packages/ras-stack"
  },
  "bin": {
    "ras": "./dist/cli.js"
  },
  "files": [
    "dist",
    "config"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./preview/dokploy": {
      "types": "./dist/preview/dokploy.d.ts",
      "default": "./dist/preview/dokploy.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run --config vitest.config.ts",
    "package:check": "node scripts/checkPackage.mjs",
    "prepare": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^4.1.12",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.15.0"
}
