{
  "name": "ras-stack-config",
  "version": "1.0.0",
  "description": "Shared TypeScript and Oxlint presets with optional import boundaries.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/richardsolomou/ras-stack.git",
    "directory": "packages/config"
  },
  "files": [
    "config"
  ],
  "type": "module",
  "exports": {
    "./config/oxlint": "./config/oxlint.json",
    "./config/oxlint/application": "./config/oxlint/application.json",
    "./config/oxlint/tanstack": "./config/oxlint/tanstack.json",
    "./config/typescript/base": "./config/typescript/base.json",
    "./config/typescript/browser": "./config/typescript/browser.json",
    "./config/typescript/bundler": "./config/typescript/bundler.json",
    "./config/typescript/library": "./config/typescript/library.json",
    "./config/typescript/node-bundler": "./config/typescript/node-bundler.json",
    "./config/typescript/tanstack": "./config/typescript/tanstack.json",
    "./config/oxlint/domain": "./config/oxlint/domain.json",
    "./config/oxlint/layers": "./config/oxlint/layers.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "tsc -p test/consumer/tsconfig.json && tsc -p test/consumer/tsconfig-bundler.json && tsc -p test/consumer/tsconfig-node-bundler.json && tsc -p test/consumer/tsconfig-library.json && oxlint --config config/oxlint/application.json --print-config > /dev/null && oxlint --config config/oxlint/tanstack.json --print-config > /dev/null",
    "test": "vitest run test/boundaries.test.ts",
    "package:check": "node scripts/checkPackedPackage.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "oxlint": "^1.74.0",
    "ras-stack-config": "workspace:*",
    "typescript": "^7.0.2",
    "vite": "8.2.1",
    "vitest": "^4.1.10"
  }
}
